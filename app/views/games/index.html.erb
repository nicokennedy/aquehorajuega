<% requested_tab = params[:tab].presence || "today" %>
<% effective_tab = requested_tab == "today" && @today_games.blank? ? "upcoming" : requested_tab %>
<% competition_landing = @competition.present? && action_name == "index" && params[:tab].blank? %>

<%
  comp = @competition&.name

  if @seo.present?
    seo_title = @seo.title
    seo_description = @seo.description
  elsif @competition.present?
    if effective_tab == "upcoming"
      seo_title = t("app.seo.upcoming_competition", competition: comp)
      seo_description = t("app.seo.desc_upcoming_competition", competition: comp)
    elsif effective_tab == "groups"
      seo_title = t("app.seo.groups_competition", competition: comp)
      seo_description = t("app.seo.desc_groups_competition", competition: comp)
    elsif effective_tab == "today"
      seo_title = t("app.seo.today_competition", competition: comp)
      seo_description = t("app.seo.desc_today_competition", competition: comp)
    else
      seo_title = t("app.seo.fixture_competition", competition: comp)
      seo_description = t("app.seo.desc_fixture_competition", competition: comp)
    end
  else
    if effective_tab == "upcoming"
      seo_title = t("app.seo.upcoming_all")
      seo_description = t("app.seo.desc_upcoming_all")
    elsif effective_tab == "today"
      seo_title = t("app.seo.today_all")
      seo_description = t("app.seo.desc_today_all")
    else
      seo_title = t("app.seo.default_all")
      seo_description = t("app.seo.desc_default_all")
    end
  end
%>

<% content_for :title, seo_title %>
<% content_for :description, seo_description %>

<% if @competition.present? %>
<script type="application/ld+json">
  <%= breadcrumb_schema([
    { name: "Inicio", url: root_url(locale: I18n.locale) },
    { name: @competition.name, url: competition_url(@competition.slug, locale: I18n.locale) }
  ]) %>
</script>
<% end %>

<% all_label = t("app.all", default: "Todos") %>
<% current_name = @competition&.name || all_label %>


<div class="page">
  <nav class="competition-nav">
    <%= link_to root_path(locale: I18n.locale), class: "nav-brand" do %>
      <%= image_tag "logo_aqhj.svg", alt: "¿A qué hora juega?", class: "nav-brand-logo" %>
    <% end %>

    <%= link_to all_label,      root_path(locale: I18n.locale, q: params[:q], tab: "today"),      class: ("active" unless @competition.present?) %>

    <% @competitions.each do |competition| %>
      <%= link_to competition.name, competition_path(competition.slug, locale: I18n.locale), class: ("active" if @competition == competition) %>
    <% end %>
  </nav>

  <header class="hero">
    <div class="topbar">
      <p class="eyebrow"><%= current_name %></p>

      <div class="locale-switcher">
        <% [:es, :en, :pt].each do |locale| %>
          <%= link_to locale.to_s.upcase,            (@competition.present? ?
              competition_path(@competition.slug, locale: locale, q: @query, tab: effective_tab) :
              root_path(locale: locale, q: @query, tab: effective_tab)),            class: ("active" if I18n.locale == locale) %>
        <% end %>
      </div>
    </div>

    <h1>
      <% if @seo.present? && !@competition.present? %>
        <%= @seo.h1 %>
      <% elsif @competition.present? %>
        <% if competition_landing %>
          <%= @seo.h1 %>
        <% elsif effective_tab == "today" %>
          <%= t("app.h1.today_competition", competition: @competition.name) %>
        <% elsif effective_tab == "upcoming" %>
          <%= t("app.h1.upcoming_competition", competition: @competition.name) %>
        <% elsif effective_tab == "groups" %>
          <%= t("app.h1.groups_competition", competition: @competition.name) %>
        <% else %>
          <%= t("app.h1.fixture_competition", competition: @competition.name) %>
        <% end %>
      <% else %>
        <%= t("app.title") %>
      <% end %>
    </h1>
    <p class="subtitle">
      <%= action_name == "today" ? full_spanish_date(@today_date) : t("app.subtitle") %>
    </p>

    <%= form_with url: (@competition.present? ? competition_path(@competition.slug) : root_path),      method: :get,      local: true,      class: "search-form",      data: { controller: "search", search_target: "form" } do %>

      <%= hidden_field_tag :locale, I18n.locale %>
      <%= hidden_field_tag :tab, effective_tab %>

      <div class="search-wrapper">
        <%= text_field_tag :q, @query, placeholder: t("app.search_placeholder"), class: "search-input", data: { action: "input->search#submit" } %>

        <% if @query.present? %>
          <%= link_to "×",            (@competition.present? ?
              competition_path(@competition.slug, locale: I18n.locale, tab: effective_tab) :
              root_path(locale: I18n.locale, tab: effective_tab)),            class: "clear-search" %>
        <% end %>
      </div>
    <% end %>
  
  

  <% if @query.present? && @matching_teams.any? %>
    <section class="team-results">
      <p class="search-label"><%= t("app.teams_found", default: "Equipos encontrados") %></p>

      <% @matching_teams.each do |team| %>
        <%= link_to team_path(team, locale: I18n.locale), class: "team-result-card" do %>
          <span><%= team.flag %></span>
          <div>
            <strong><%= team.name %></strong>
            <small><%= t("app.view_full_fixture", default: "Ver fixture completo") %></small>
          </div>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <% unless competition_landing %>
  <div class="tabs">
    <%= link_to "#{t("app.today")} #{@today_games.count}",      (@competition.present? ?
        competition_today_path(@competition.slug, locale: I18n.locale, q: @query) :
        root_path(locale: I18n.locale, q: @query, tab: "today")),      class: "tab #{'active' if effective_tab == 'today'}" %>

    <%= link_to "#{t("app.upcoming")} #{@upcoming_games.count}",      (@competition.present? ?
        competition_upcoming_path(@competition.slug, locale: I18n.locale, q: @query) :
        root_path(locale: I18n.locale, q: @query, tab: "upcoming")),      class: "tab #{'active' if effective_tab == 'upcoming'}" %>

    <% if @groups.any? %>
      <%= link_to "Grupos",        (@competition.present? ?
          competition_groups_path(@competition.slug, locale: I18n.locale, q: @query) :
          root_path(locale: I18n.locale, q: @query, tab: "groups")),        class: "tab #{'active' if effective_tab == 'groups'}" %>
    <% end %>
  </div>
  <% end %>

    <% unless @competition.present? %>
    <% end %>

  <% if competition_landing %>
    <section class="competition-intro">
      <p>Consultá los partidos confirmados, próximos encuentros y resultados recientes de <%= @competition.name %>.</p>
    </section>

    <section class="section">
      <h2>Partidos de hoy de <%= @competition.name %></h2>
      <% if @today_games.any? %>
        <% @today_games.each do |game| %>
          <%= render "game_card", game: game, source: "competition_today" %>
        <% end %>
      <% else %>
        <p class="empty">No hay partidos confirmados para hoy en esta competición.</p>
      <% end %>
    </section>

    <section class="section">
      <h2>Próximos partidos</h2>
      <% if @upcoming_games.any? %>
        <% @upcoming_games.each do |game| %>
          <%= render "game_card", game: game, source: "competition_upcoming" %>
        <% end %>
      <% else %>
        <p class="empty">No hay próximos partidos confirmados.</p>
      <% end %>
    </section>

    <section class="section">
      <h2>Últimos resultados</h2>
      <% if @recent_games.any? %>
        <% @recent_games.each do |game| %>
          <%= render "game_card", game: game, source: "competition_results" %>
        <% end %>
      <% else %>
        <p class="empty">No hay resultados recientes disponibles.</p>
      <% end %>
    </section>

    <% if @competition_teams.any? %>
      <section class="seo-links">
        <h2>Equipos de <%= @competition.name %></h2>
        <% @competition_teams.sort_by(&:name).each do |team| %>
          <%= link_to team.name, team_path(team, locale: I18n.locale),
            data: { analytics_event: "competition_to_team", analytics_source: @competition.slug, analytics_team: team.slug } %>
        <% end %>
      </section>
    <% end %>
  <% elsif effective_tab == "groups" %>
    <section class="groups-section">
      <% group_tables = @groups.flat_map { |group_block| group_block["tables"] } %>

        <div class="group-anchor-nav">
          <% group_tables.each do |group| %>
            <a href="#<%= group["name"].parameterize %>"><%= group["name"] %></a>
          <% end %>
        </div>

        <% group_tables.each do |group| %>
          <% table = group["table"] %>

          <div class="group-card" id="<%= group["name"].parameterize %>">
            <h2><%= group["name"] %></h2>
            <% destinations = table["destinations"] || [] %>

            <% if destinations.any? %>
              <div class="group-legend">
                <% destinations.each do |destination| %>
                  <span>
                    <i style="background:<%= destination["color"] %>"></i>
                    <%= destination["name"] %>
                  </span>
                <% end %>
              </div>
            <% end %>

            <table class="group-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Equipo</th>
                  <th>PTS</th>
                  <th>J</th>
                  <th>G</th>
                  <th>E</th>
                  <th>P</th>
                </tr>
              </thead>

              <tbody>
                <% table["rows"].each do |row| %>
                  <% values = row["values"].index_by { |v| v["key"] } %>

                  <tr>
                    <% team = row.dig("entity", "object") %>

                    <td><%= row["num"] %></td>

                    <td>
                      <span class="group-team">
                        <% if team["country_id"].present? %>
                          <img
                            src="https://api.promiedos.com.ar/images/country/<%= team["country_id"] %>/1"
                            alt="<%= team["name"] %>"
                          >
                        <% end %>

                        <strong><%= team["name"] %></strong>
                      </span>
                    </td>
                    <td><%= values.dig("Points", "value") %></td>
                    <td><%= values.dig("GamePlayed", "value") %></td>
                    <td><%= values.dig("GamesWon", "value") %></td>
                    <td><%= values.dig("GamesEven", "value") %></td>
                    <td><%= values.dig("GamesLost", "value") %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
    </section>
  <% else %>
    <section class="section">
      <% games = effective_tab == "upcoming" ? @upcoming_games : @today_games %>

      <% if games.any? %>
        <% grouped_games = action_name == "today" ? games.group_by(&:competition) : games.group_by { |game| game.starts_at.in_time_zone("America/Argentina/Buenos_Aires").to_date } %>
        <% grouped_games.each do |group, day_games| %>
          <% date = group unless action_name == "today" %>
          <% if action_name == "today" %>
            <div class="day-separator competition-separator">
              <span><%= group&.name || "Otros partidos" %></span>
            </div>
          <% end %>
          <% if effective_tab == "upcoming" %>
            <div class="day-separator">
              <span><%= l(date, format: "%A %d/%m") %></span>
            </div>
          <% end %>

          <% day_games.each do |game| %>
            <%= render "game_card", game: game, source: (action_name == "today" ? "today" : "upcoming") %>
          <% end %>
        <% end %>
      <% else %>
        <p class="empty">
          <%= effective_tab == "today" ? t("app.no_games_today") : t("app.no_upcoming_games", default: "No hay próximos partidos.") %>
        </p>
      <% end %>
    </section>
  <% end %>

  <% unless competition_landing %>
  <section class="seo-text">
    <h2><%= @competition.present? ? t("app.h1.fixture_section", competition: current_name) : t("app.title") %></h2>

    <p>
      Consultá todos los partidos de <%= current_name %> con horarios adaptados automáticamente a tu país.
      Podés buscar por equipo, ciudad o estadio, ver cuándo juega cada equipo y entrar a cada partido para comparar
      tu horario local con la hora en sede.
    </p>

    <p>
      Esta página se actualiza para mostrar próximos partidos, partidos de hoy y resultados en vivo cuando estén disponibles.
    </p>
  </section>
  <% end %>

  <% if action_name == "today" && @priority_teams.any? %>
    <section class="seo-links popular-teams-section">
      <h2>Equipos prioritarios</h2>
      <% @priority_teams.each do |team| %>
        <%= link_to "Próximo partido de #{team.name}", team_path(team, locale: I18n.locale),
          data: { analytics_event: "today_to_team", analytics_source: "today", analytics_team: team.slug } %>
      <% end %>
    </section>
  <% end %>
</div>

<script>
  function formatMainTime(date) {
    return new Intl.DateTimeFormat("es-AR", {
      timeZone: "America/Argentina/Buenos_Aires",      hour: "2-digit",      minute: "2-digit",      hour12: false
    }).format(date);
  }

  function formatDate(date) {
    return new Intl.DateTimeFormat("es-AR", {
      timeZone: "America/Argentina/Buenos_Aires",      weekday: "short",      day: "2-digit",      month: "2-digit"
    }).format(date);
  }

  function countdownText(date) {
    const now = new Date();
    const diff = date - now;

    if (diff <= 0) return "Por empezar";

    const minutes = Math.floor(diff / 60000);
    const hours = Math.floor(minutes / 60);
    const days = Math.floor(hours / 24);

    if (days > 0) return `Faltan ${days}d ${hours % 24}h`;
    if (hours > 0) return `Faltan ${hours}h ${minutes % 60}m`;
    return `Faltan ${minutes}m`;
  }

  document.querySelectorAll("[data-local-main-time]").forEach((el) => {
    const date = new Date(el.dataset.localMainTime);
    el.innerText = formatMainTime(date);
  });

  document.querySelectorAll("[data-local-date]").forEach((el) => {
    const date = new Date(el.dataset.localDate);
    el.innerText = formatDate(date);
  });

  document.querySelectorAll("[data-countdown]").forEach((el) => {
    const date = new Date(el.dataset.countdown);
    el.innerText = countdownText(date);
  });
</script>
