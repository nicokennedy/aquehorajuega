<% content_for :title, @seo.title %>
<% content_for :description, @seo.description %>

<script type="application/ld+json">
  <%= sports_event_schema(@game, ticket_link: @ticket_link) %>
</script>
<script type="application/ld+json">
  <%= breadcrumb_schema([
    { name: "Inicio", url: root_url(locale: I18n.locale) },
    (@game.competition ? { name: @game.competition.name, url: competition_url(@game.competition.slug, locale: I18n.locale) } : nil),
    { name: "#{@game.home_team.name} vs #{@game.away_team.name}", url: game_url(@game, locale: I18n.locale) }
  ].compact) %>
</script>

<div class="page">
  <%= link_to t("app.back"), @game.competition ? competition_path(@game.competition.slug, locale: I18n.locale) : root_path(locale: I18n.locale), class: "back-link" %>

  <article class="match-detail">
    <header class="hero match-hero">
      <p class="eyebrow"><%= @game.competition&.name || "Partido" %></p>
      <h1><%= @seo.h1 %></h1>
      <span class="status-pill status-<%= @game.status %>"><%= game_status_label(@game) %></span>

      <div class="match-detail-teams">
        <%= link_to @game.home_team.name, team_path(@game.home_team, locale: I18n.locale), class: "match-team-link" %>
        <% if @game.live? || @game.finished? %>
          <strong class="match-detail-score"><%= @game.score_text == "vs" ? game_status_label(@game) : @game.score_text %></strong>
        <% else %>
          <strong>vs</strong>
        <% end %>
        <%= link_to @game.away_team.name, team_path(@game.away_team, locale: I18n.locale), class: "match-team-link" %>
      </div>

      <dl class="match-facts">
        <div><dt>Fecha</dt><dd><%= full_spanish_date(@game.starts_at) %></dd></div>
        <div><dt>Hora Argentina</dt><dd><%= hora_argentina(@game.starts_at) %></dd></div>
        <div>
          <dt>Tu hora local</dt>
          <dd data-local-main-time="<%= @game.starts_at.iso8601 %>"><%= hora_argentina(@game.starts_at) %></dd>
        </div>
        <% if @game.competition %>
          <div><dt>Competición</dt><dd><%= @game.competition.name %></dd></div>
        <% end %>
        <% if @game.stage.present? %>
          <div><dt>Fase</dt><dd><%= @game.stage %></dd></div>
        <% end %>
        <% if @game.stadium.present? %>
          <div><dt>Estadio</dt><dd><%= @game.stadium %></dd></div>
        <% end %>
        <% if @game.city.present? %>
          <div><dt>Ciudad</dt><dd><%= @game.city %></dd></div>
        <% end %>
      </dl>

      <div class="hero-actions">
        <%= link_to "Agregar partido al calendario",
          calendar_game_path(@game, locale: I18n.locale, format: :ics),
          class: "button button-secondary",
          data: { analytics_event: "calendar_click", analytics_source: "game", analytics_game: @game.slug } %>
      </div>
      <%= render "ticket_cta", ticket_link: @ticket_link, source: "game" %>
    </header>

    <% [[@game.home_team, @home_upcoming_games], [@game.away_team, @away_upcoming_games]].each do |team, games| %>
      <section class="section">
        <h2>Próximos partidos de <%= team.name %></h2>
        <% if games.any? %>
          <% games.each do |game| %>
            <%= render "game_card", game: game, team_context: team, source: "game_related" %>
          <% end %>
        <% else %>
          <p class="empty">No hay próximos partidos confirmados.</p>
        <% end %>
      </section>
    <% end %>
  </article>
</div>
