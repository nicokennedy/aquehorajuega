<% content_for :title, @seo.title %>
<% content_for :description, @seo.description %>

<script type="application/ld+json">
  <%= faq_schema_for_team(@team, today_games: @today_games, upcoming_games: @upcoming_games) %>
</script>
<script type="application/ld+json">
  <%= breadcrumb_schema([
    { name: "Inicio", url: root_url(locale: I18n.locale) },
    { name: @team.name, url: team_url(@team, locale: I18n.locale) }
  ]) %>
</script>
<% if @focus_game %>
  <script type="application/ld+json">
    <%= sports_event_schema(@focus_game, ticket_link: @ticket_link) %>
  </script>
<% end %>

<div class="page">
  <%= link_to t("app.back"), root_path(locale: I18n.locale), class: "back-link" %>

  <header class="hero team-hero">
    <p class="eyebrow"><%= @today_games.any? ? "Juega hoy" : "Fixture" %></p>
    <h1><%= @seo.h1 %></h1>
    <% if @focus_game %>
      <% rival = @focus_game.opponent_for(@team) %>
      <div class="next-match-hero">
        <span class="status-pill status-<%= @focus_game.status %>"><%= game_status_label(@focus_game) %></span>
        <strong><%= @team.name %> vs <%= rival&.name %></strong>
        <p>
          <%= full_spanish_date(@focus_game.starts_at) %> ·
          <%= hora_argentina(@focus_game.starts_at) %> AR
          <% if @focus_game.competition %> · <%= @focus_game.competition.name %><% end %>
        </p>
        <% if @focus_game.stadium.present? %>
          <p><%= @focus_game.stadium %><%= " · #{@focus_game.city}" if @focus_game.city.present? %></p>
        <% end %>
        <% if (distance = days_until_game(@focus_game)) %>
          <p class="countdown-natural">El partido es <%= distance %>.</p>
        <% end %>
        <%= link_to "Ver detalles del partido", game_path(@focus_game, locale: I18n.locale),
          class: "button",
          data: { analytics_event: "team_to_match", analytics_source: "team_hero", analytics_game: @focus_game.slug } %>
      </div>
    <% else %>
      <p class="subtitle">No hay un próximo partido confirmado para <%= @team.name %>. Esta página se actualizará cuando exista un fixture verificable.</p>
    <% end %>

    <div class="hero-actions">
      <%= link_to "Descargar calendario de #{@team.name}",
        calendar_team_path(@team, locale: I18n.locale, format: :ics),
        class: "button button-secondary",
        data: { analytics_event: "calendar_click", analytics_source: "team", analytics_team: @team.slug } %>
    </div>
    <%= render "games/ticket_cta", ticket_link: @ticket_link, source: "team" %>
  </header>

  <section class="section">
    <h2>Próximos partidos de <%= @team.name %></h2>
    <% cache games_fragment_key(["team-upcoming", @team.id], @upcoming_games) do %>
      <% if @upcoming_games.any? %>
        <% @upcoming_games.each do |game| %>
          <%= render "games/game_card", game: game, team_context: @team, source: "team_upcoming" %>
        <% end %>
      <% else %>
        <p class="empty">No hay próximos partidos confirmados.</p>
      <% end %>
    <% end %>
  </section>

  <section class="section">
    <h2>Últimos resultados de <%= @team.name %></h2>
    <% cache games_fragment_key(["team-results", @team.id], @past_games) do %>
      <% if @past_games.any? %>
        <% @past_games.each do |game| %>
          <%= render "games/game_card", game: game, team_context: @team, source: "team_results" %>
        <% end %>
      <% else %>
        <p class="empty">No hay resultados recientes disponibles.</p>
      <% end %>
    <% end %>
  </section>
</div>
