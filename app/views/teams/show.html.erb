<script type="application/ld+json">
  <%= faq_schema_for_team(@team) %>
</script>

<% content_for :title do %>
  <% if @upcoming_games.any? %>
    ¿A qué hora juega <%= @team.name %>? | Próximo <%= @upcoming_games.first.starts_at.in_time_zone("America/Argentina/Buenos_Aires").strftime("%-d/%-m") %>
  <% else %>
    ¿A qué hora juega <%= @team.name %>? | Fixture y horarios
  <% end %>
<% end %>

<% content_for :description do %>
  <% if @upcoming_games.any? %>
    <% rival = @upcoming_games.first.home_team == @team ? @upcoming_games.first.away_team.name : @upcoming_games.first.home_team.name %>
    Próximo partido de <%= @team.name %>: <%= rival %> el <%= @upcoming_games.first.starts_at.in_time_zone("America/Argentina/Buenos_Aires").strftime("%-d de %B a las %H:%M") %>hs. Fixture completo y horario en tu país.
  <% else %>
    Fixture completo de <%= @team.name %>, horarios en tu país y resultados en vivo.
  <% end %>
<% end %>

<div class="page">
  <%= link_to t("app.back"), root_path(locale: I18n.locale), class: "back-link" %>

  <header class="hero team-hero">
    <p class="eyebrow">Fixture</p>
    <h1> ¿A qué hora juega <%= @team.name %>?</h1>
    <p class="subtitle">
      Próximos partidos de <%= @team.name %>, horario local automático, competencia y estadio.
    </p>
    <div class="team-today-link">
      <%= link_to "Ver si #{@team.name} juega hoy →", today_team_path(@team, locale: I18n.locale) %>
    </div>
  </header>

  <section class="section">
    <h2>Partidos de hoy de <%= @team.name %></h2>

    <% if @today_games.any? %>
      <% @today_games.each do |game| %>
        <%= render "games/game_card", game: game %>
      <% end %>
    <% else %>
      <p class="empty">No hay partidos hoy.</p>
    <% end %>
  </section>


  <section class="section">
    <h2>Próximos partidos de <%= @team.name %></h2>

    <% if @upcoming_games.any? %>
      <% @upcoming_games.each do |game| %>
        <%= render "games/game_card", game: game %>
      <% end %>
    <% else %>
      <p class="empty">No hay próximos partidos cargados.</p>
    <% end %>
  </section>

  <% competitions = @upcoming_games.map(&:competition).compact.uniq %>

  <% if competitions.any? %>
    <section class="seo-links">
      <h2><%= @team.name %> por competencia</h2>

      <% competitions.each do |competition| %>
        <%= link_to "#{@team.name} en #{competition.name}", competition_url_for(competition, q: @team.name) %>
      <% end %>
    </section>
  <% end %>

    <section class="section faq-section">
      <h2>Preguntas frecuentes sobre <%= @team.name %></h2>

      <div class="faq-item">
        <h3>¿A qué hora juega <%= @team.name %> hoy?</h3>
        <p>
          <% if @today_games.any? %>
            <%= @team.name %> juega hoy a las <%= @today_games.first.starts_at.in_time_zone("America/Argentina/Buenos_Aires").strftime("%H:%M") %>hs (hora Argentina). El horario en tu país se muestra arriba automáticamente.
          <% else %>
            <%= @team.name %> no juega hoy.
            <% if @upcoming_games.any? %>
              Su próximo partido es el <%= @upcoming_games.first.starts_at.in_time_zone("America/Argentina/Buenos_Aires").strftime("%-d de %B") %>.
            <% end %>
          <% end %>
        </p>
      </div>

      <div class="faq-item">
        <h3>¿Cuáles son los próximos partidos de <%= @team.name %>?</h3>
        <p>
          <% if @upcoming_games.any? %>
            El próximo partido de <%= @team.name %> es el <%= @upcoming_games.first.starts_at.in_time_zone("America/Argentina/Buenos_Aires").strftime("%-d de %B") %> contra <%= @upcoming_games.first.home_team == @team ? @upcoming_games.first.away_team.name : @upcoming_games.first.home_team.name %>.
          <% else %>
            No hay próximos partidos cargados para <%= @team.name %>.
          <% end %>
        </p>
      </div>

      <div class="faq-item">
        <h3>¿En qué competencias juega <%= @team.name %>?</h3>
        <p>
          <% competitions = @upcoming_games.map(&:competition).compact.uniq %>
          <% if competitions.any? %>
            <%= @team.name %> tiene partidos en <%= competitions.map(&:name).to_sentence %>.
          <% else %>
            Consultá el fixture completo de <%= @team.name %> en esta página.
          <% end %>
        </p>
      </div>
    </section>

  <section class="seo-text">
    <h2>Fixture de <%= @team.name %></h2>
    <p>
      En esta página podés consultar a qué hora juega <%= @team.name %>, ver sus próximos partidos
      y revisar el horario adaptado automáticamente a tu país. También podés entrar a cada partido
      para ver la hora en sede, el estadio y el tiempo restante para el inicio.
    </p>
  </section>

  <section class="seo-links">
    <h2>Más fixtures</h2>

    <% Competition.order(:name).each do |competition| %>
      <%= link_to competition.name, competition_url_for(competition) %>
    <% end %>
  </section>
</div>

<script>
  function formatMainTime(date) {
      return new Intl.DateTimeFormat(undefined, {
        hour: "2-digit",
        minute: "2-digit",
        hour12: false
      }).format(date);
    }

    function formatDate(date) {
      return new Intl.DateTimeFormat(undefined, {
        day: "2-digit",
        month: "2-digit"
      }).format(date);
    }

  function countdownText(date) {
    const now = new Date();
    const diff = date - now;

    if (diff <= 0) return "Por empezar";

    const minutes = Math.floor(diff / 60000);
    const hours = Math.floor(minutes / 60);
    const days = Math.floor(hours / 24);

    if (days > 0) return `Faltan ${days}d ${hours % 24}h`;
    if (hours > 0) return `Faltan ${hours}h ${minutes % 60}m`;
    return `Faltan ${minutes}m`;
  }

  document.querySelectorAll("[data-local-main-time]").forEach((el) => {
    const date = new Date(el.dataset.localMainTime);
    el.innerText = formatMainTime(date);
  });

  document.querySelectorAll("[data-local-date]").forEach((el) => {
    const date = new Date(el.dataset.localDate);
    el.innerText = formatDate(date);
  });

  document.querySelectorAll("[data-countdown]").forEach((el) => {
    const date = new Date(el.dataset.countdown);
    el.innerText = countdownText(date);
  });
</script>