<% content_for :title do %>
  <% if @today_games.any? %>
    ¿A qué hora juega <%= @team.name %> hoy? | <%= @today_games.first.starts_at.in_time_zone("America/Argentina/Buenos_Aires").strftime("%-d/%-m - %H:%Mhs") %>
  <% elsif @next_game.present? %>
    ¿A qué hora juega <%= @team.name %>? | Próximo <%= @next_game.starts_at.in_time_zone("America/Argentina/Buenos_Aires").strftime("%-d/%-m") %>
  <% else %>
    ¿A qué hora juega <%= @team.name %>? | Fixture y horarios
  <% end %>
<% end %>

<% content_for :description do %>
  <% if @today_games.any? %>
    <%= "#{@team.name} juega hoy a las #{@today_games.first.starts_at.in_time_zone("America/Argentina/Buenos_Aires").strftime("%H:%M")}hs. Horario en tu país, TV en vivo y más info del partido." %>
  <% elsif @next_game.present? %>
    <%= "#{@team.name} no juega hoy. Próximo partido: #{@next_game.starts_at.in_time_zone("America/Argentina/Buenos_Aires").strftime("%-d de %B")}. Fixture y horario local." %>
  <% else %>
    <%= "Fixture completo de #{@team.name}, horarios en tu país y resultados en vivo." %>
  <% end %>
<% end %>

<div class="page">
  <%= link_to "← Volver a #{@team.name}", team_path(@team, locale: I18n.locale), class: "back-link" %>

  <header class="hero team-hero">
    <p class="eyebrow">Partido de hoy</p>

    <h1>¿A qué hora juega <%= @team.name %> hoy?</h1>

    <p class="subtitle">
      Horario actualizado, competencia y próximo partido de <%= @team.name %>.
    </p>
  </header>

  <section class="section">
    <% if @today_games.any? %>
      <h2><%= @team.name %> juega hoy</h2>

      <% @today_games.each do |game| %>
        <%= render "games/game_card", game: game %>
      <% end %>
    <% else %>
      <h2><%= @team.name %> no juega hoy</h2>

      <% if @next_game.present? %>
        <p class="empty">
          El próximo partido de <%= @team.name %> es:
        </p>

        <%= render "games/game_card", game: @next_game %>
      <% else %>
        <p class="empty">
          No hay próximos partidos cargados para <%= @team.name %>.
        </p>
      <% end %>
    <% end %>
  </section>

  <section class="section faq-section">
    <h2>Preguntas frecuentes sobre <%= @team.name %> hoy</h2>

    <div class="faq-item">
      <h3>¿<%= @team.name %> juega hoy?</h3>
      <p>
        En esta página podés ver si <%= @team.name %> juega hoy y consultar el horario actualizado del partido.
      </p>
    </div>

    <div class="faq-item">
      <h3>¿A qué hora juega <%= @team.name %>?</h3>
      <p>
        El horario se muestra actualizado y adaptado a tu país para que puedas saber cuándo empieza el partido.
      </p>
    </div>

    <div class="faq-item">
      <h3>¿Cuál es el próximo partido de <%= @team.name %>?</h3>
      <p>
        Si <%= @team.name %> no juega hoy, mostramos el próximo partido disponible en el fixture.
      </p>
    </div>
  </section>
</div>