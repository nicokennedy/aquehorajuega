<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>
      <%= content_for?(:title) ? yield(:title) : "¿A qué hora juega?" %>
    </title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Partidos de hoy, fixture, horarios locales y resultados en vivo de fútbol. Mundial 2026, Libertadores, Sudamericana y más." %>">
    <meta property="og:image" content="<%= image_url('logopng1.png') %>">
    <meta name="twitter:image" content="<%= image_url('logopng1.png') %>">
    <meta property="og:title" content="<%= content_for?(:title) ? yield(:title) : "¿A qué hora juega?" %>">
    <meta property="og:description" content="<%= content_for?(:description) ? yield(:description) : "Partidos de hoy, fixture, horarios locales y resultados en vivo de fútbol. Mundial 2026, Libertadores, Sudamericana y más." %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="¿A qué hora juega?">
    <meta property="og:url" content="<%= request.original_url %>">

    <meta property="og:image" content="<%= image_url('logopng1.png') %>">
    <meta property="og:image:secure_url" content="<%= image_url('logopng1.png') %>">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="<%= image_url('logopng1.png') %>">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for?(:title) ? yield(:title) : "¿A qué hora juega?" %>">
    <meta name="twitter:description" content="<%= content_for?(:description) ? yield(:description) : "Partidos de hoy, fixture, horarios locales y resultados en vivo de fútbol. Mundial 2026, Libertadores, Sudamericana y más." %>">
    <% noindex_actions = %w[upcoming_competition today_competition groups] %>
    <% if noindex_actions.include?(action_name) %>
      <meta name="robots" content="noindex, follow">
    <% end %>
    <link rel="canonical" href="<%= request.base_url + request.path %>">
    <link rel="alternate" hreflang="es" href="<%= request.base_url + request.path.gsub(/^\/(es|en|pt)\//, '/es/') %>">
    <link rel="alternate" hreflang="en" href="<%= request.base_url + request.path.gsub(/^\/(es|en|pt)\//, '/en/') %>">
    <link rel="alternate" hreflang="pt" href="<%= request.base_url + request.path.gsub(/^\/(es|en|pt)\//, '/pt/') %>">
    <link rel="alternate" hreflang="x-default" href="<%= request.base_url + request.path.gsub(/^\/(es|en|pt)\//, '/es/') %>">
    <link rel="icon" href="<%= asset_path('favicon_aqhj.svg') %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= asset_path('favicon_aqhj.svg') %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>